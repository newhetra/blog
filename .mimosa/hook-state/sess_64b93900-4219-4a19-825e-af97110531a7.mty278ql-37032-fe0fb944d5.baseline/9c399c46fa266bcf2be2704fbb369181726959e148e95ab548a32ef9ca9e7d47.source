// 站点全局配置：想改博客的名字和简介，只需要改这里
export const SITE_TITLE = '我的博客';
export const SITE_DESCRIPTION = '记录文章、随笔与项目';

// 三个独立栏目：每个栏目对应 src/content/ 下的一个文件夹，互相独立，可自由增减改名
// （改这里的 label 会同时更新导航和首页；改 key 的话需要同步改文件夹名和 pages 下的页面）
export const SECTIONS = [
  { key: 'posts', label: '文章', path: '/posts/', description: '技术分享与深度内容' },
  { key: 'notes', label: '随笔', path: '/notes/', description: '日常记录与碎片想法' },
  { key: 'projects', label: '项目', path: '/projects/', description: '个人项目与作品' },
] as const;
