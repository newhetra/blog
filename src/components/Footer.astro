---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
  <p>© {year} {SITE_TITLE} · 由 <a href="https://astro.build">Astro</a> 与 <a href="https://pages.cloudflare.com">Cloudflare Pages</a> 驱动 · <a href="/rss.xml">RSS</a></p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: auto;
    padding: 1.5rem 1.25rem 2.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  footer a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  footer a:hover {
    color: var(--accent);
  }
</style>
